# ============================================================================
# TP Flame — variáveis de ambiente
# ============================================================================

# VITE_GAS_ENDPOINT
#   URL /exec do Web App do Google Apps Script que atende a planilha.
#   É a ÚNICA configuração de backend: o app pergunta a esse endpoint qual
#   planilha usar (?action=whoami), então não existe um segundo valor que
#   possa divergir dele.
#
#   ⚠️ NÃO é um segredo. Toda variável VITE_* é embutida no bundle durante o
#   build e fica visível no DevTools de qualquer visitante. Defini-la na
#   Vercel serve para trocar de planilha sem commit e separar produção de
#   testes — não para esconder a URL.
#
#   Sem esta variável, o app usa o fallback definido em src/services/storage.ts.
VITE_GAS_ENDPOINT="https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec"

# ----------------------------------------------------------------------
# Firebase (Fase 4 — ver docs/PLANO-FASE4-MIGRACAO-FIREBASE.md)
# ----------------------------------------------------------------------
# Config pública do projeto Firebase (Firestore + Authentication). NÃO é
# segredo — quem protege os dados são as Security Rules do Firestore
# (firestore.rules), não esconder estes valores. Pegue em: Firebase Console
# > Configurações do projeto > Seus apps > app Web "tp-flame-web".
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="tp-flame.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tp-flame"
VITE_FIREBASE_STORAGE_BUCKET="tp-flame.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# GEMINI_API_KEY: usada pelas chamadas à API Gemini.
# Injetada em runtime pelo AI Studio a partir dos secrets do usuário.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde este applet está hospedado.
APP_URL="MY_APP_URL"
